PORT=8080
NODE_ENV=production

# Persistent data directory (mount a Railway volume here)
HVPN_DATA_DIR=/data

# Secret used to sign admin session cookies. CHANGE THIS.
JWT_SECRET=change-me-to-a-long-random-string

# Xray-core release to download on first boot
XRAY_VERSION=v26.9.9

# Internal Xray API + inbound base port (usually no need to change)
XRAY_API_PORT=10085
XRAY_INBOUND_BASE_PORT=20000

# Public domain used to build client links. Railway sets RAILWAY_PUBLIC_DOMAIN
# automatically; override only if you use a custom domain.
PUBLIC_DOMAIN=
